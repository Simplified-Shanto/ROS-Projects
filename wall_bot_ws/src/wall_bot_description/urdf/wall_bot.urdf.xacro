<?xml version="1.0"?>
<robot name="wall_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================= -->
  <!-- Basic dimensions -->
  <!-- ========================= -->

  <!-- Scale the original wall bot down so its footprint is close to LazyGo. -->
  <xacro:property name="model_scale" value="0.39"/>

  <xacro:property name="base_length" value="${0.40 * model_scale}"/>
  <xacro:property name="base_width"  value="${0.25 * model_scale}"/>
  <xacro:property name="base_height" value="${0.12 * model_scale}"/>

  <xacro:property name="wheel_radius" value="${0.065 * model_scale}"/>
  <xacro:property name="wheel_width"  value="${0.035 * model_scale}"/>

  <xacro:property name="wheel_separation" value="${0.34 * model_scale}"/>
  <xacro:property name="wheel_diameter" value="${0.13 * model_scale}"/>

  <xacro:property name="base_origin_z" value="${0.12 * model_scale}"/>
  <xacro:property name="wheel_x_offset" value="${0.10 * model_scale}"/>
  <xacro:property name="wheel_marker_length" value="${0.035 * model_scale}"/>
  <xacro:property name="wheel_marker_width" value="${0.002 * model_scale}"/>
  <xacro:property name="wheel_marker_height" value="${0.018 * model_scale}"/>

  <xacro:property name="laser_radius" value="${0.055 * model_scale}"/>
  <xacro:property name="laser_length" value="${0.04 * model_scale}"/>
  <xacro:property name="laser_x_offset" value="${0.1}"/>
  <xacro:property name="laser_z_offset" value="${0.20 * model_scale}"/>


  <xacro:property name="camera_x_offset" value="0.11"/>
  <xacro:property name="camera_y_offset" value="0.0"/>
  <xacro:property name="camera_z_offset" value="0.10"/>
  <xacro:property name="camera_pitch" value="0.1"/>



  <!-- ========================= -->
  <!-- Materials -->
  <!-- ========================= -->

  <material name="orange">
    <color rgba="1.0 0.45 0.1 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
	
  <material name="white"> 
    <color rgba="1.0 1.0 1.0 1.0"/> 
  </material> 
  



  <!-- ========================= -->
  <!-- Wheel macro -->
  <!-- ========================= -->

<xacro:macro name="wheel_link" params="name">
  <link name="${name}">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>
</xacro:macro>

<xacro:wheel_link name="rear_left_wheel_link"/>
<xacro:wheel_link name="rear_right_wheel_link"/>
<xacro:wheel_link name="front_left_wheel_link"/>
<xacro:wheel_link name="front_right_wheel_link"/>



  <!-- ========================= -->
  <!-- Base link -->
  <!-- ========================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_origin_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${base_origin_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${base_origin_z}" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.03" ixy="0.0" ixz="0.0"
        iyy="0.03" iyz="0.0"
        izz="0.04"/>
    </inertial>
  </link>

  <!-- ========================= -->
  <!--Front box link -->
  <!-- ========================= -->

    <link name="front_box_link">
    <visual>
      <origin xyz="0 0 ${base_origin_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length/2} ${base_width/2.2} ${base_height}"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${base_origin_z}" rpy="0 0 0"/>
      <geometry>
         <box size="${base_length/2} ${base_width/2} ${base_height/2}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${base_origin_z}" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.03" ixy="0.0" ixz="0.0"
        iyy="0.03" iyz="0.0"
        izz="0.04"/>
    </inertial>
  </link>


    <joint name="front_box_base_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_box_link"/>
    <origin xyz="${base_length/2} 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!--Rear Left wheel -->
  <!-- ========================= -->

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-${wheel_x_offset} ${wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <!-- Left wheel rotation marker -->
<link name="rear_left_wheel_marker_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="${wheel_marker_length} ${wheel_marker_width} ${wheel_marker_height}"/>
    </geometry>
    <material name="white"/>
  </visual>
</link>

<joint name="rear_left_wheel_marker_joint" type="fixed">
  <parent link="rear_left_wheel_link"/>
  <child link="rear_left_wheel_marker_link"/>
  <origin xyz="${wheel_radius*0.65} ${wheel_width/2 } 0" rpy="0 0 0"/>
</joint>
  

  <!-- ========================= -->
  <!-- Rear Right wheel -->
  <!-- ========================= -->


  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="-${wheel_x_offset} -${wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  
  <!-- Rear Right wheel rotation marker -->
<link name="rear_right_wheel_marker_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="${wheel_marker_length} ${wheel_marker_width} ${wheel_marker_height}"/>
    </geometry>
    <material name="white"/>
  </visual>
</link>

<joint name="rear_right_wheel_marker_joint" type="fixed">
  <parent link="rear_right_wheel_link"/>
  <child link="rear_right_wheel_marker_link"/>
  <origin xyz="${wheel_radius*0.65} -${wheel_width/2} 0" rpy="0 0 0"/>
</joint>



  <!-- ========================= -->
  <!-- Front Left Wheel -->
  <!-- ========================= -->

<link name = "front_left_steer_link"> 
 <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.015 0.01"/>
      </geometry>
      <material name="white"/>
    </visual>

  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.01 0.015 0.01"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.02"/>
    <inertia
      ixx="0.00001" ixy="0.0" ixz="0.0"
      iyy="0.00001" iyz="0.0"
      izz="0.00001"/>
  </inertial>
</link> 

<joint name = "front_left_steer_joint" type="revolute">
  <parent link="base_link"/>
  <child link="front_left_steer_link"/>
  <origin xyz="${base_length / 1.4} ${base_width/2.4} ${wheel_radius}" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit lower="-0.6" upper="0.6" effort="10.0" velocity="5.0" /> 
</joint>


  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


    <!-- Front Left wheel rotation marker -->
<link name="front_left_wheel_marker_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="${wheel_marker_length} ${wheel_marker_width} ${wheel_marker_height}"/>
    </geometry>
    <material name="white"/>
  </visual>
</link>

<joint name="front_left_wheel_marker_joint" type="fixed">
  <parent link="front_left_wheel_link"/>
  <child link="front_left_wheel_marker_link"/>
  <origin xyz="${wheel_radius*0.65} ${wheel_width/2 } 0" rpy="0 0 0"/>
</joint>
  




  <!-- ========================= -->
  <!-- Front Right Wheel -->
  <!-- ========================= -->
<link name = "front_right_steer_link"> 
 <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.015 0.01"/>
      </geometry>
      <material name="white"/>
    </visual>

  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.01 0.015 0.01"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.02"/>
    <inertia
      ixx="0.00001" ixy="0.0" ixz="0.0"
      iyy="0.00001" iyz="0.0"
      izz="0.00001"/>
  </inertial>
</link> 

<joint name = "front_right_steer_joint" type="revolute">
  <parent link="base_link"/>
  <child link="front_right_steer_link"/>
  <origin xyz="${base_length / 1.4} -${base_width/2.4} ${wheel_radius}" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit lower="-0.6" upper="0.6" effort="10.0" velocity="5.0" /> 
</joint>


  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


    <!-- Front Left wheel rotation marker -->
<link name="front_right_wheel_marker_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="${wheel_marker_length} ${wheel_marker_width} ${wheel_marker_height}"/>
    </geometry>
    <material name="white"/>
  </visual>
</link>

<joint name="front_right_wheel_marker_joint" type="fixed">
  <parent link="front_right_wheel_link"/>
  <child link="front_right_wheel_marker_link"/>
  <origin xyz="${wheel_radius*0.65} ${wheel_width/2 } 0" rpy="0 0 0"/>
</joint>
  



  <!-- ========================= -->
  <!-- LiDAR -->
  <!-- ========================= -->

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_length}"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_length}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0002" ixy="0.0" ixz="0.0"
        iyy="0.0002" iyz="0.0"
        izz="0.0002"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="${laser_x_offset} 0 ${laser_z_offset}" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- CAMERA -->
  <!-- ========================= -->

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.03 0.02"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x_offset} ${camera_y_offset} ${camera_z_offset}"
            rpy="0 ${camera_pitch} 0"/>
  </joint>

  <link name="camera_link_optical"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>



  <!-- ========================= -->
  <!-- Gazebo material/friction -->
  <!-- ========================= -->

  <gazebo reference="base_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="front_box_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="front_left_steer_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="front_right_steer_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="front_left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>20.0</mu1>
    <mu2>20.0</mu2>
    <slip1>0.0</slip1>
    <slip2>0.0</slip2>
  </gazebo>

  <gazebo reference="front_right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>20.0</mu1>
    <mu2>20.0</mu2>
    <slip1>0.0</slip1>
    <slip2>0.0</slip2>
  </gazebo>

  <gazebo reference="rear_left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>20.0</mu1>
    <mu2>20.0</mu2>
    <slip1>0.0</slip1>
    <slip2>0.0</slip2>
  </gazebo>

  <gazebo reference="rear_right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>20.0</mu1>
    <mu2>20.0</mu2>
    <slip1>0.0</slip1>
    <slip2>0.0</slip2>
  </gazebo>

 


  <!-- ========================= -->
  <!-- Gazebo LiDAR sensor -->
  <!-- ========================= -->

  <gazebo reference="laser_link">
    <sensor name="lidar_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>

      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>

      <plugin name="gazebo_ros_laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ========================= -->
  <!-- Gazebo Camera -->
  <!-- ========================= -->
  <gazebo reference="camera_link">
  <sensor name="line_camera" type="camera">
    <always_on>true</always_on>
    <visualize>true</visualize>
    <update_rate>30</update_rate>

    <camera>
      <horizontal_fov>2.79253</horizontal_fov>
      <image>
        <width>1280</width>
        <height>720</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>2.0</far>
      </clip>
    </camera>

    <plugin name="line_camera_plugin" filename="libgazebo_ros_camera.so">
      <camera_name>line_camera</camera_name>
      <frame_name>camera_link_optical</frame_name>
    </plugin>
  </sensor>
</gazebo>


  <!-- ========================= -->
  <!-- Ros2 control              --> 
  <!-- ========================= -->

<ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>

  <joint name="front_left_steer_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>

  <joint name="front_right_steer_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>

  <joint name="front_left_wheel_joint">
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="front_right_wheel_joint">
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="rear_left_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="velocity"/>
    <state_interface name="position"/>
  </joint>

  <joint name="rear_right_wheel_joint">
    <command_interface name="velocity"/>
    <state_interface name="velocity"/>
    <state_interface name="position"/>
  </joint>
</ros2_control>

  <!-- ========================= -->
  <!-- Plug in for Ros2 control              --> 
  <!-- ========================= -->

<gazebo>
  <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
    <parameters>$(find wall_bot_gazebo)/config/ackermann_controllers.yaml</parameters>
  </plugin>
</gazebo>









</robot>
